# Database Configuration
# Local SQLite: "file:./dev.db"
# Production Supabase PostgreSQL: "postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
DATABASE_URL="file:./dev.db"

# JWT Secret for Session Cookies (Set a cryptographically secure random string with minimum 32 characters)
JWT_SECRET=""

# Public Site URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Cloud Storage (Supabase Storage / Cloudinary)
# NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="..."
# SUPABASE_SERVICE_ROLE_KEY="..."
